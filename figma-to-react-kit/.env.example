# Copy this file to ".env" at the Vite project root.
# Never commit .env or paste the token into chat.

# Figma → Settings → Personal access tokens
FIGMA_TOKEN=figd_xxxxxxxx

# From the URL: https://www.figma.com/design/FILE_ID/File-Name?...
FIGMA_FILE_ID=your_file_id_here

# From the URL: node-id=2683-6274  →  2683:6274
# Dash in the URL becomes a colon for the API.
FIGMA_NODE_ID=2683:6274
